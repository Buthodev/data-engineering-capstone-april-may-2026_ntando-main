      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{676577EF-5B7F-418C-A2AE-40CC4E1EB1EC}"
          SQLTask:SqlStatementSource="WITH Duplicates AS&#xA;( &#xA;SELECT&#xA;client_number,&#xA;first_name,&#xA;last_name,&#xA;event_type,&#xA;event_date,&#xA;ROW_NUMBER() OVER (&#xA;PARTITION BY&#xA;client_number,&#xA;first_name,&#xA;last_name,&#xA;event_type,&#xA;event_date&#xA;ORDER BY client_number&#xA;) AS RowNum&#xA;FROM staging.customer_activity_extract&#xA;)&#xA;DELETE FROM Duplicates&#xA;WHERE RowNum &gt; 1;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
