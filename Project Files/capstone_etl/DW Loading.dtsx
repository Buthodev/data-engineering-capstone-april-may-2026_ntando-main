      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7C641430-75A9-4E36-B04D-B5144466AEDC}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.databases&#xA;    WHERE name = 'Customer360_DW'&#xA;)&#xA;BEGIN&#xA;    CREATE DATABASE Customer360_DW;&#xA;END;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create DW dim and fact tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F025DDC4-CA4E-4E30-839C-F5F73D3AF3CC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create DW dim and fact tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7C641430-75A9-4E36-B04D-B5144466AEDC}"
          SQLTask:SqlStatementSource="USE Customer360_DW&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'dim_client'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dim_client (&#xA;        client_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        client_number VARCHAR(50),&#xA;        first_name VARCHAR(100),&#xA;        last_name VARCHAR(100),&#xA;        gender VARCHAR(20),&#xA;        date_of_birth DATE,&#xA;        signup_date DATE,&#xA;        mobile_number VARCHAR(30),&#xA;        email VARCHAR(255)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'dim_location'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dim_location (&#xA;        location_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        city VARCHAR(100),&#xA;        province VARCHAR(100)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'dim_event'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dim_event (&#xA;        event_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        event_date DATE,&#xA;        event_type VARCHAR(100)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'dim_flag'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dim_flag (&#xA;        flag_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        resolved_flag VARCHAR(10)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'dim_channel'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dim_channel (&#xA;        channel_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        channel VARCHAR(100)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'dim_account'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dim_account (&#xA;        account_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        account_number VARCHAR(50),&#xA;        product_type VARCHAR(100),&#xA;        account_status VARCHAR(50),&#xA;        transaction_type VARCHAR(100)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'dim_interaction'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dim_interaction (&#xA;        interaction_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;        interaction_type VARCHAR(100)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'fact_account_activity'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE fact_account_activity (&#xA;        activity_id BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;        event_id INT,&#xA;        location_id INT,&#xA;        client_id INT,&#xA;        account_id INT,&#xA;        interaction_id INT,&#xA;        flag_id INT,&#xA;        channel_id INT,&#xA;&#xA;        loan_amount DECIMAL(18,2),&#xA;        credit_limit DECIMAL(18,2),&#xA;        amount DECIMAL(18,2),&#xA;        account_balance DECIMAL(18,2),&#xA;&#xA;        FOREIGN KEY (event_id)&#xA;            REFERENCES dim_event(event_id),&#xA;&#xA;        FOREIGN KEY (location_id)&#xA;            REFERENCES dim_location(location_id),&#xA;&#xA;        FOREIGN KEY (client_id)&#xA;            REFERENCES dim_client(client_id),&#xA;&#xA;        FOREIGN KEY (account_id)&#xA;            REFERENCES dim_account(account_id),&#xA;&#xA;        FOREIGN KEY (interaction_id)&#xA;            REFERENCES dim_interaction(interaction_id),&#xA;&#xA;        FOREIGN KEY (flag_id)&#xA;            REFERENCES dim_flag(flag_id),&#xA;&#xA;        FOREIGN KEY (channel_id)&#xA;            REFERENCES dim_channel(channel_id)&#xA;    );&#xA;END;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create DW Schema"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D7CC7E85-5BBB-4263-BA0B-04780F240649}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create DW Schema"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7C641430-75A9-4E36-B04D-B5144466AEDC}"
          SQLTask:SqlStatementSource="USE Customer360_DW;&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = 'dw'&#xA;)&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA dw');&#xA;END;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load dims from staging to dw"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BC33732F-880C-4F64-8C13-805DF140D1FF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load dims from staging to dw"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7C641430-75A9-4E36-B04D-B5144466AEDC}"
          SQLTask:SqlStatementSource="-- Load data into dim_client table from staging table&#xA;&#xA;INSERT INTO dim_client (&#xA;    client_number,&#xA;    first_name,&#xA;    last_name,&#xA;    gender,&#xA;    date_of_birth,&#xA;    signup_date,&#xA;    mobile_number,&#xA;    email&#xA;)&#xA;SELECT DISTINCT&#xA;    s.client_number,&#xA;    s.first_name,&#xA;    s.last_name,&#xA;    s.gender,&#xA;    s.date_of_birth,&#xA;    s.signup_date,&#xA;    s.mobile_number,&#xA;    s.email&#xA;FROM stg_Customer360.staging.customer_activity_extract s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dim_client d&#xA;    WHERE d.client_number = s.client_number&#xA;);&#xA;&#xA;&#xA;-- Load data into dim_location table from staging table&#xA;&#xA;INSERT INTO dim_location (&#xA;    city,&#xA;    province&#xA;)&#xA;SELECT DISTINCT&#xA;    s.city,&#xA;    s.province&#xA;FROM stg_Customer360.staging.customer_activity_extract s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dim_location d&#xA;    WHERE d.city = s.city&#xA;      AND d.province = s.province&#xA;);&#xA;&#xA;&#xA;-- Load data into dim_event table from staging table&#xA;&#xA;INSERT INTO dim_event (&#xA;    event_date,&#xA;    event_type&#xA;)&#xA;SELECT DISTINCT&#xA;    s.event_date,&#xA;    s.event_type&#xA;FROM stg_Customer360.staging.customer_activity_extract s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dim_event d&#xA;    WHERE d.event_date = s.event_date&#xA;      AND d.event_type = s.event_type&#xA;);&#xA;&#xA;&#xA;-- Load data into dim_flag table from staging table&#xA;&#xA;INSERT INTO dim_flag (&#xA;    resolved_flag&#xA;)&#xA;SELECT DISTINCT&#xA;    s.resolved_flag&#xA;FROM stg_Customer360.staging.customer_activity_extract s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dim_flag d&#xA;    WHERE d.resolved_flag = s.resolved_flag&#xA;);&#xA;&#xA;&#xA;-- Load data into dim_channel table from staging table&#xA;&#xA;INSERT INTO dim_channel (&#xA;    channel&#xA;)&#xA;SELECT DISTINCT&#xA;    s.channel&#xA;FROM stg_Customer360.staging.customer_activity_extract s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dim_channel d&#xA;    WHERE d.channel = s.channel&#xA;);&#xA;&#xA;&#xA;-- Load data into dim_account table from staging table&#xA;&#xA;INSERT INTO dim_account (&#xA;    account_number,&#xA;    product_type,&#xA;    account_status,&#xA;    transaction_type&#xA;)&#xA;SELECT DISTINCT&#xA;    s.account_number,&#xA;    s.product_type,&#xA;    s.account_status,&#xA;    s.transaction_type&#xA;FROM stg_Customer360.staging.customer_activity_extract s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dim_account d&#xA;    WHERE d.account_number = s.account_number&#xA;      AND d.product_type = s.product_type&#xA;      AND d.account_status = s.account_status&#xA;      AND d.transaction_type = s.transaction_type&#xA;);&#xA;&#xA;&#xA;-- Load data into dim_interaction table from staging table&#xA;&#xA;INSERT INTO dim_interaction (&#xA;    interaction_type&#xA;)&#xA;SELECT DISTINCT&#xA;    s.interaction_type&#xA;FROM stg_Customer360.staging.customer_activity_extract s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dim_interaction d&#xA;    WHERE d.interaction_type = s.interaction_type&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load fact into dw"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4EF2C881-2235-406D-A03E-52BC11E97F32}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load fact into dw"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7C641430-75A9-4E36-B04D-B5144466AEDC}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.fact_account_activity&#xA;)&#xA;BEGIN&#xA;    INSERT INTO dbo.fact_account_activity&#xA;    (&#xA;        event_id,&#xA;        location_id,&#xA;        client_id,&#xA;        account_id,&#xA;        interaction_id,&#xA;        flag_id,&#xA;        channel_id,&#xA;        loan_amount,&#xA;        credit_limit,&#xA;        amount,&#xA;        account_balance&#xA;    )&#xA;    SELECT DISTINCT&#xA;        e.event_id,&#xA;        l.location_id,&#xA;        c.client_id,&#xA;        a.account_id,&#xA;        i.interaction_id,&#xA;        f.flag_id,&#xA;        ch.channel_id,&#xA;&#xA;        TRY_CONVERT(DECIMAL(18,2), s.loan_amount),&#xA;        TRY_CONVERT(DECIMAL(18,2), s.credit_limit),&#xA;        TRY_CONVERT(DECIMAL(18,2), s.amount),&#xA;        TRY_CONVERT(DECIMAL(18,2), s.account_balance)&#xA;&#xA;    FROM stg_Customer360.staging.customer_activity_extract AS s&#xA;&#xA;    INNER JOIN dbo.dim_event AS e&#xA;        ON e.event_date = TRY_CONVERT(DATE, s.event_date)&#xA;       AND e.event_type = s.event_type&#xA;&#xA;    INNER JOIN dbo.dim_location AS l&#xA;        ON l.city = s.city&#xA;       AND l.province = s.province&#xA;&#xA;    INNER JOIN dbo.dim_client AS c&#xA;        ON c.client_number = s.client_number&#xA;&#xA;    INNER JOIN dbo.dim_account AS a&#xA;        ON a.account_number = s.account_number&#xA;&#xA;    INNER JOIN dbo.dim_interaction AS i&#xA;        ON i.interaction_type = s.interaction_type&#xA;&#xA;    INNER JOIN dbo.dim_flag AS f&#xA;        ON UPPER(LTRIM(RTRIM(f.resolved_flag))) =&#xA;           UPPER(LTRIM(RTRIM(s.resolved_flag)))&#xA;&#xA;    INNER JOIN dbo.dim_channel AS ch&#xA;        ON ch.channel = s.channel;&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
